[Unit]
Description=MosquitoSentinel — Real-time Mosquito Detection Dashboard
After=network.target
Wants=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/mosquito
ExecStart=/home/pi/mosquito_env/bin/uvicorn sentinel_pi.app:app --host 0.0.0.0 --port 8000 --workers 1
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
